# Clone/development mode: use the deployed Robogo application as the API gateway.
# Leave this unset on the canonical VPS deployment to keep database work local.
REMOTE_API_URL=https://api-robogo.qtitpc.dev

# Public URL of this frontend instance.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use a long random value for local cookie signing. Never commit the real secret.
LOCAL_AUTH_SECRET=replace-with-a-long-random-secret
